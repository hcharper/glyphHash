# ===========================================
# GlyphHash Environment Configuration
# ===========================================

# Node Environment
NODE_ENV=development

# ===========================================
# Hedera Configuration (Testnet)
# Get credentials at: https://portal.hedera.com
# ===========================================
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=302e020100300506...

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://glyphhash:glyphhash@localhost:5432/glyphhash

# ===========================================
# Redis (Caching & Pub/Sub)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Storage (S3 or LocalStack for dev)
# ===========================================
STORAGE_TYPE=local
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_BUCKET=glyphhash-documents
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ===========================================
# API Configuration
# ===========================================
API_PORT=4000
API_HOST=localhost
API_URL=http://localhost:4000

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Auth0 (Future - Not Required for MVP)
# ===========================================
# AUTH0_SECRET=
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# ===========================================
# Monitoring (Future)
# ===========================================
# SENTRY_DSN=
# DATADOG_API_KEY=

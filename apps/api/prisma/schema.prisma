// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// Topics - Hedera HCS Topics
// ===========================================
model Topic {
  id                String     @id @default(uuid())
  topicId           String     @unique // Hedera topic ID (e.g., "0.0.123456")
  name              String
  description       String?
  ownerId           String     // User ID (future auth integration)
  companyIdentifier String
  bindingHash       String     // Hash of companyId + topicId
  bindingTimestamp  DateTime?
  bindingTxId       String?    // Transaction ID of binding message

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  documents         Document[]

  @@index([ownerId])
  @@index([companyIdentifier])
}

// ===========================================
// Documents - Uploaded files with hashes
// ===========================================
model Document {
  id                String         @id @default(uuid())
  topicId           String
  topic             Topic          @relation(fields: [topicId], references: [id])

  filename          String         // Storage filename (UUID-based)
  originalName      String         // Original filename
  mimeType          String
  size              Int            // File size in bytes
  
  category          DocumentCategory
  description       String?
  hash              String         // SHA-256 hash of file content
  storagePath       String         // Path in S3/local storage
  
  status            DocumentStatus @default(PENDING)
  sequenceNumber    Int?           // HCS message sequence number
  consensusTimestamp DateTime?     // Hedera consensus timestamp
  transactionId     String?        // Hedera transaction ID
  
  metadata          Json?          // Additional metadata
  
  version           Int            @default(1)
  previousVersionId String?        // Link to previous version
  previousVersion   Document?      @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  nextVersions      Document[]     @relation("DocumentVersions")
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([topicId])
  @@index([hash])
  @@index([status])
  @@index([category])
  @@index([consensusTimestamp])
}

// ===========================================
// Verification Reports
// ===========================================
model VerificationReport {
  id              String   @id @default(uuid())
  topicId         String
  totalDocuments  Int
  verified        Int
  mismatches      Int
  notFound        Int
  errors          Int
  results         Json     // Array of VerificationResult
  generatedBy     String?  // User ID
  
  createdAt       DateTime @default(now())

  @@index([topicId])
  @@index([createdAt])
}

// ===========================================
// Audit Log (for compliance)
// ===========================================
model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE_TOPIC, UPLOAD_DOCUMENT, VERIFY_DOCUMENT, etc.
  entityType  String   // Topic, Document, etc.
  entityId    String
  userId      String?
  ipAddress   String?
  userAgent   String?
  details     Json?
  
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ===========================================
// Enums
// ===========================================
enum DocumentCategory {
  SECURITY_MONITORING
  ACCESS_CONTROL
  INCIDENT_RESPONSE
  CHANGE_MANAGEMENT
  RISK_ASSESSMENT
  COMPLIANCE_AUDIT
  POLICY_DOCUMENT
  EVIDENCE
  OTHER
}

enum DocumentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}
